{
  "name": "romsync-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:unit": "vitest run --project=unit",
    "capture": "node --experimental-strip-types --disable-warning=ExperimentalWarning parity/capture/capture.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit -p .",
    "bundle": "next build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/manifest.ts out",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/tokens.ts",
    "api": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/api.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@storybook/react": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
