# --- build output, caches and virtual environments --------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- scratch, backups and logs ----------------------------------------------
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*.temp
*.part
*.partial
*~
*.log
tmp/
_scratch*/
_push/
_holding/
_deleted/

# --- editor and operating system --------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
